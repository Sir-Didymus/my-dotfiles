{
  // ══════════════════════════════════════════════════════════════════
  //  BAR
  //  The bar itself is transparent (see style.css). Everything you see
  //  is a "pill": either a group/ box or a single module styled as one.
  // ══════════════════════════════════════════════════════════════════
  "layer": "top",
  "position": "top",
  "height": 34,

  // 0 — all gaps between pills come from CSS `margin`, so the look is
  // controlled in one place instead of split between JSON and CSS.
  "spacing": 0,

  // Float the bar off the screen edges. Use these instead of a CSS
  // margin on window#waybar so the reserved (exclusive) zone is correct.
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  // Re-reads style.css whenever you save it — no need to restart waybar.
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces", "mpris"],
  "modules-center": ["hyprland/window"],
  // Array order is LEFT to RIGHT, so this reads as:
  //   [tray]  [cpu ram battery]  [brightness volume net clock]
  "modules-right": ["tray", "group/resources", "group/status"],

  // ══════════════════════════════════════════════════════════════════
  //  GROUPS — these are your <div>s.
  //
  //  "group/resources"  ->  CSS selector  #resources   (name after the /)
  //
  //  IMPORTANT: "orientation" defaults to "orthogonal", which on a
  //  horizontal bar means the children stack VERTICALLY. Always set
  //  "horizontal" explicitly for a top bar.
  //
  //  Not every pill needs a group: a lone module is already its own box,
  //  so #workspaces / #mpris / #window are styled as pills directly.
  //  That also means they vanish cleanly when they have nothing to show,
  //  which an empty group box would not.
  // ══════════════════════════════════════════════════════════════════
  "group/resources": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "battery"],
  },

  "group/status": {
    "orientation": "horizontal",
    "modules": ["backlight", "pulseaudio", "network", "clock"],
  },

  // ══════════════════════════════════════════════════════════════════
  //  MODULES
  // ══════════════════════════════════════════════════════════════════
  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "disable-scroll": true,
    "warp-on-scroll": false,
    "on-click": "activate",
    // Uncomment for a fixed row of workspaces that are always visible:
    // "persistent-workspaces": { "*": 5 },
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
  },

  // Built-in media module (your build links libplayerctl, so it works).
  // Hidden automatically when no player is running.
  "mpris": {
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{status_icon}  <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 35,
    "max-length": 45,
    "player-icons": { "default": "󰐊" },
    "status-icons": { "paused": "󰏤" },
  },

  // All icons below are Material Design glyphs (nf-md-*) from the Nerd
  // Font — the outline style used in the reference screenshot. Every one
  // is verified present in JetBrainsMonoNerdFont-Regular.ttf.

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "tooltip": false,
  },

  "memory": {
    "format": "󰍛 {}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "min-brightness": 1,
    "tooltip": false,
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰦢",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
  },

  // Symbol only, as in the screenshot — SSID and IP live in the tooltip,
  // which also keeps a long SSID from stretching the pill.
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-linked": "󰌙",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} · {ipaddr}/{cidr} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} ({power:0.1f} W)",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },

  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰃭 {:%a %d %b}", // click to toggle
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
}
